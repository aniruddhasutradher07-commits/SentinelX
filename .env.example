GEMINI_API_KEY=
NEWS_API_KEY=
WEATHERAPI_KEY=
OPENWEATHERMAP_API_KEY=    # Optional: enables OpenWeatherMap as weather source
PORT=8000

# FastAPI Cloud Backend (Render)
VITE_API_BASE_URL=https://sentinelx-pi9j.onrender.com

# Supabase Realtime (PostgreSQL CDC on ward_risk_index table)
# Optional: If unset or offline, SentinelX automatically falls back to local SSE stream
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Twilio SMS API for Emergency Broadcasting
# Optional: If unset, SentinelX uses offline dummy alerts
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_PHONE=+1234567890

# Fast2SMS (Alternative for India testing)
# Priority is given to Fast2SMS if provided.
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# SentinelX Data Pipeline Settings
USE_MOCK_DATA=false
WEATHER_PROVIDER=open_meteo
FALLBACK_WEATHER_PROVIDER=
WEATHER_REFRESH_SECONDS=600
DATA_STALE_AFTER_MINUTES=30

# Open-Meteo Batch Configuration
OPEN_METEO_BATCH_SIZE=10
OPEN_METEO_TIMEOUT_SECONDS=15
OPEN_METEO_MAX_RETRIES=3
OPEN_METEO_BACKOFF_SECONDS=1

# CPCB Official Data.gov.in API
CPCB_ENABLED=true
CPCB_API_KEY=your_data_gov_in_api_key_here
CPCB_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
CPCB_TIMEOUT_SECONDS=15
CPCB_REFRESH_SECONDS=900
CPCB_MAX_RETRIES=3

# SentinelX Data Pipeline Settings
USE_MOCK_DATA=false

WEATHER_PROVIDER=open_meteo
FALLBACK_WEATHER_PROVIDER=

WEATHER_REFRESH_SECONDS=600
DATA_STALE_AFTER_MINUTES=30

BHUVAN_LULC50K_TOKEN=your_bhuvan_token_here