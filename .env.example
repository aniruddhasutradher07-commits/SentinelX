# ==============================================================================
# HeatGuard AI / SentinelX — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your specific credentials for local execution:
#   cp .env.example .env
# NOTE: Never commit .env or real credentials to source control.
# ==============================================================================

# Server & Runtime Configuration
PORT=8000
APP_ENV=development
API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=https://sentinelx-thermal-api-production-aa42.up.railway.app

# Database Configuration (Optional - Defaults to local SQLite / In-Memory cache)
DATABASE_URL=sqlite:///./sentinelx_data.db

# Gemini AI Copilot (Optional)
# Enables natural-language operational advisory with safety guardrails
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# CPCB (Central Pollution Control Board) Data.gov.in API (Optional)
# If credentials are not configured, CPCB features gracefully degrade to synthetic/offline fallback
CPCB_ENABLED=true
CPCB_API_KEY=YOUR_CPCB_DATA_GOV_IN_API_KEY_HERE
CPCB_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
CPCB_TIMEOUT_SECONDS=15
CPCB_REFRESH_SECONDS=900
CPCB_MAX_RETRIES=3

# IMD (India Meteorological Department) Weather Context (Optional)
# If not configured, gracefully reports CREDENTIALS_NOT_CONFIGURED status
IMD_API_KEY=YOUR_IMD_API_KEY_HERE
IMD_ENABLED=true

# ISRO Bhuvan Spatial Earth Observation (Optional)
BHUVAN_LULC50K_TOKEN=YOUR_BHUVAN_TOKEN_HERE

# Weather Data Provider Settings
# HeatGuard AI natively leverages Open-Meteo for high-precision live observations
WEATHER_PROVIDER=open_meteo
FALLBACK_WEATHER_PROVIDER=
# Safe Demo Fallback Policy (Hackathon Resilience)
# In production, USE_MOCK_DATA and ENABLE_DEMO_FALLBACK default strictly to false.
# Real external sources and SQLite database caches are always preferred.
# For offline hackathon booths where external APIs fail, opt-in via ENABLE_DEMO_FALLBACK=true.
# Every fallback payload/UI is explicitly labeled: "DEMO / SYNTHETIC — NOT LIVE".
# No fake clinical/hospital outcomes are ever generated.
USE_MOCK_DATA=false
ENABLE_DEMO_FALLBACK=false

# Open-Meteo Batch Configuration
OPEN_METEO_BATCH_SIZE=10
OPEN_METEO_TIMEOUT_SECONDS=15
OPEN_METEO_MAX_RETRIES=3
OPEN_METEO_BACKOFF_SECONDS=1

# Supabase Realtime Telemetry Sync (Optional)
# If unset or offline, SentinelX automatically falls back to local SSE stream
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Emergency SMS Broadcast Gateways (Optional / Dry-Run Simulation Mode Default)
# Twilio Gateway:
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_FROM_PHONE=+1234567890

# Fast2SMS Gateway (Alternative for India testing):
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY_HERE

# Optional Secondary Weather Providers
WEATHERAPI_KEY=YOUR_WEATHERAPI_KEY_HERE
OPENWEATHERMAP_API_KEY=YOUR_OPENWEATHERMAP_API_KEY_HERE
NEWS_API_KEY=YOUR_NEWS_API_KEY_HERE